# Source and configuration files use LF on every platform.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.toml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.nvmrc text eol=lf
.prettierignore text eol=lf
.gitattributes text eol=lf

# Windows-native scripts retain CRLF checkouts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
