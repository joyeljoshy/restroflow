{
  "name": "restroflow",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time restaurant operations management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev -w @restroflow/web\" \"npm run dev -w @restroflow/api\"",
    "dev:web": "npm run dev -w @restroflow/web",
    "dev:api": "npm run dev -w @restroflow/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @restroflow/web",
    "db:generate": "npm run db:generate -w @restroflow/api",
    "db:migrate": "npm run db:migrate -w @restroflow/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @restroflow/api",
    "db:seed": "npm run db:seed -w @restroflow/api",
    "db:studio": "npm run db:studio -w @restroflow/api"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1"
  }
}
