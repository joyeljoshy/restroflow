NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://restroflow:replace_with_your_local_password@localhost:5432/restroflow?schema=public
# Neon CLI writes its direct, non-pooler migration URL with this name while
# DATABASE_URL uses the pooled endpoint. Optional for local development.
# DATABASE_URL_UNPOOLED=postgresql://restroflow:replace_with_your_local_password@localhost:5432/restroflow?schema=public
# Other providers and existing deployments may use DIRECT_URL instead.
# DIRECT_URL=postgresql://restroflow:replace_with_your_local_password@localhost:5432/restroflow?schema=public
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=5
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
IMAGE_STORAGE_PROVIDER=local
MENU_IMAGE_DIRECTORY=uploads/menu

# Required only when IMAGE_STORAGE_PROVIDER=cloudinary. Keep every value server-side.
# CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
# CLOUDINARY_API_KEY=replace_with_api_key
# CLOUDINARY_API_SECRET=replace_with_api_secret
# CLOUDINARY_FOLDER=restroflow/menu

# Optional, development-only initial admin seed. Set all four values together.
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=replace_with_a_long_local_password
# ADMIN_SEED_NAME=Local Admin
# ADMIN_SEED_RESTAURANT_SLUG=local-restaurant
# ADMIN_SEED_RESTAURANT_NAME=Local Restaurant
